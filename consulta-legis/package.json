{
  "name": "consulta-legis",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/consulta-legis/ingest.ts --if-empty && tsx --env-file-if-exists=.env src/server.ts",
